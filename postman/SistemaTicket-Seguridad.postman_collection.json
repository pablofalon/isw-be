{
  "info": {
    "name": "SistemaTicket-BE — Modulo de Seguridad",
    "description": "Coleccion para validar el modulo de seguridad: creacion de usuario semilla, login (exito, password incorrecto, usuario inexistente) y logout (con y sin token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "testUsername", "value": "testuser", "type": "string" },
    { "key": "testPassword", "value": "Password123!", "type": "string" },
    { "key": "testPasswordHash", "value": "$2a$10$OdywK5MVYlKS7z2DlqyONuTQuO7PJz3E4mNHXsVdfvxvrKVW7iltW", "type": "string" },
    { "key": "createdUserId", "value": "", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0 - Setup",
      "item": [
        {
          "name": "Crear usuario semilla (POST /api/users)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Devuelve el username enviado', function () {",
                  "    pm.expect(body.username).to.eql(pm.collectionVariables.get('testUsername'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('createdUserId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"username\": \"{{testUsername}}\",\n  \"passwordHash\": \"{{testPasswordHash}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "El passwordHash usado aca corresponde al hash BCrypt precalculado de la contrasena en texto plano 'Password123!' (la misma que se usa en la request de Login exitoso). Se envia ya hasheado porque el modulo no expone un endpoint de 'registro' con password en texto plano — el hasheo lo hace CryptoManager en el flujo interno, no en este endpoint de alta administrativa."
          }
        }
      ]
    },
    {
      "name": "1 - Login",
      "item": [
        {
          "name": "Login exitoso (200 + token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Devuelve un token no vacio', function () {",
                  "    pm.expect(body.token).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('authToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login con password incorrecto (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Mensaje generico Invalid credentials', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Invalid credentials');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"ContraseñaIncorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login con usuario inexistente (401, mismo mensaje)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Mismo mensaje generico que password incorrecto (no filtra existencia del usuario)', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Invalid credentials');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario_que_no_existe\",\n  \"password\": \"cualquiera\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "2 - Logout",
      "item": [
        {
          "name": "Logout exitoso (204, con token valido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            },
            "description": "Requiere haber corrido antes 'Login exitoso' en esta misma ejecucion de la coleccion, para que {{authToken}} este seteado."
          }
        },
        {
          "name": "Logout sin header Authorization (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Mensaje Missing session token', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Missing session token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    }
  ]
}
